proc load_actual_proc {path name} {
 set f [open $path r];set text [read $f];close $f;set collecting 0;set body ""
 foreach line [split $text \n] {
  if {!$collecting && [string match "proc $name *" $line]} {set collecting 1}
  if {$collecting} {append body $line \n;if {[info complete $body]} {uplevel #0 $body;return}}
 }
 error "Missing actual procedure $name"
}
proc run_fresh {} {
 global fspr_ndm fspr_dev fspr_release_binding vars env
 set env(PDK_ROOT) $env(USC144_QUERY_REPO)
 uplevel #0 [list source [file join $env(USC144_QUERY_SOURCES) {PDK Development/Front-side Version/selected_collateral.tcl}]]
 uplevel #0 [list source [file join $env(USC144_QUERY_SOURCES) {PDK Development/Front-side Version/icc2_matched_references.tcl}]]
 set fspr_ndm $env(USC144_QUERY_REF)
 set fspr_dev [file join [pwd] {fixture release}]
 set fspr_release_binding $env(USC144_QUERY_BINDING)
 unset -nocomplain env(HARDNDM)
 set path [file join $env(USC144_QUERY_SOURCES) {PnR-Synopsys/Front-side Version/Runfiles/ECG_icc2.tcl}]
 set f [open $path r];set text [read $f];close $f
 foreach line [split $text \n] {
  if {[regexp {^set vars\((Place,SiteDef|Route,VerticalMetals|Route,HorizontalMetals)\)} $line]} {uplevel #0 $line}
 }
 load_actual_proc $path prc_ICC_createLibs
 load_actual_proc $path prc_ICC_setupConfig
 prc_ICC_createLibs
 read_verilog empty.v
 prc_ICC_setupConfig
 puts "USC144_NATIVE_FRESH_REFS [get_attribute [current_lib] ref_libs]"
 puts "USC144_NATIVE_FRESH_SITE [sizeof_collection [get_site_defs -quiet -exact $vars(Place,SiteDef)]]"
 save_lib
 puts USC144_NATIVE_GUARDED_FRESH_CREATE_PASS
}
if {[catch {run_fresh} message]} {puts "USC144_NATIVE_GUARD_ERROR $message";exit 1}
