proc make_fixture {} {
create_workspace -flow physical_only -technology tech.tf ref_fixture
set_app_options -name lib.workspace.keep_all_physical_cells -value true
read_lef -include tech tech.lef
read_lef -preserve_lef_cell_site cells.lef
if {[sizeof_collection [get_site_defs -quiet -exact coreSite]]<1} {error "Missing coreSite"}
check_workspace
commit_workspace -output fixture_physical.ndm
puts USC144_PRIVATE_PHYSICAL_REFERENCE_FIXTURE_PASS
}
if {[catch {make_fixture} message]} {puts "USC144_FIXTURE_ERROR $message";exit 1}
